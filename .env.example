# 仅用于本地演示数据库；真实数据库请改为自己的最小权限账号。
PGSCOPE_DSN=postgresql://pgscope_reader:pgscope_demo_readonly@127.0.0.1:55432/pgscope_demo
PGSCOPE_ALLOWED_SCHEMAS=public
PGSCOPE_ALLOW_ANALYZE=false
PGSCOPE_STATEMENT_TIMEOUT_MS=5000
PGSCOPE_LOCK_TIMEOUT_MS=1000
PGSCOPE_CONNECT_TIMEOUT_SECONDS=5

# 服务不自动加载 .env。请显式设置环境变量或使用 uv run --env-file .env。
# 演示管理凭据仅在运行 benchmark 时单独设置，不放入 MCP 客户端配置。
